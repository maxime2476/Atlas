# Environnements Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environnement R (renv conserve renv.lock, pas la bibliothèque locale)
.Rhistory
.RData
renv/library/

# Secrets et identifiants (Copernicus, API, etc.)
.env
.env.*
!.env.example

# Données : seuls les README de documentation sont versionnés.
# Les données brutes et volumineuses doivent pouvoir être retéléchargées.
data/**
!data/**/
!data/**/README.md

# Sorties générées
reports/figures/

# Fichiers système Windows / WSL
*:Zone.Identifier
Thumbs.db
desktop.ini

# Préférences locales Claude Code
.claude/settings.local.json

# README téléchargés avec les commandes AppEEARS (fichiers bruts NASA, non rédigés par le projet)
data/raw/nasa_appeears/*/README.md

# Note de recherche : brouillon local, non versionné (choix de l'auteur)
docs/note_recherche.md

# Skills tiers academic-research-skills (CC BY-NC 4.0), installés localement, non redistribués
.claude/vendor/
.claude/skills/academic-paper
.claude/skills/academic-paper-reviewer
.claude/skills/academic-pipeline
.claude/skills/deep-research
.claude/skills/sr-screener
